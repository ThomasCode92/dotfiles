#!/bin/bash

TMUX_PLUGIN_DIR="$HOME/.tmux/plugins"

if ! command -v tmux >/dev/null 2>&1; then
  echo "📦 tmux not found, installing it..."
  {{ if eq .chezmoi.os "darwin" }}
  brew install tmux
  {{ else if eq .chezmoi.os "linux" }}
  sudo pacman -S --needed --noconfirm tmux
  {{ else }}
  echo "❌ Unsupported OS: {{ .chezmoi.os }}. Please install tmux manually."
  exit 1
  {{ end }}

  if ! command -v tmux >/dev/null 2>&1; then
    echo "❌ tmux installation failed."
    exit 1
  fi
  echo "✅ tmux installed successfully"
else
  echo "⏭️  tmux already installed, installation skipped"
fi

if [[ ! -e "$TMUX_PLUGIN_DIR/tpm" ]]; then
  echo "📦 Installing tpm..."
  git clone https://github.com/tmux-plugins/tpm "$TMUX_PLUGIN_DIR/tpm"
  echo "✅ tpm installed successfully"
else
  echo "⏭️  tpm already installed, installation skipped"
fi

echo "🔌 Installing tmux plugins..."
"$TMUX_PLUGIN_DIR/tpm/scripts/install_plugins.sh"
echo "✅ tmux plugins installed successfully"
