#!/bin/bash
set -euo pipefail

# Install SDKMAN! if it is not already present.
# `sdk` is a fish function, so detect an existing installation by its init script.

{{ if eq .chezmoi.os "linux" -}}
sdkman_dir="${SDKMAN_DIR:-$HOME/.sdkman}"
{{ else if eq .chezmoi.os "darwin" -}}
sdkman_dir="${SDKMAN_DIR:-$(brew --prefix)/opt/sdkman-cli/libexec}"
{{ else -}}
echo "❌ Unsupported OS: {{ .chezmoi.os }}. Please install SDKMAN manually."
exit 1
{{ end }}

if [[ -f "$sdkman_dir/bin/sdkman-init.sh" ]]; then
  echo "⏭️ SDKMAN already installed at $sdkman_dir."
  exit 0
fi

echo "📥 Installing SDKMAN"

{{ if eq .chezmoi.os "linux" -}}
if ! command -v curl >/dev/null || ! command -v zip >/dev/null || ! command -v unzip >/dev/null; then
  echo "📦 Installing prerequisites (curl, zip, unzip)"
  sudo pacman -S --needed --noconfirm zip unzip
fi

curl -s "https://get.sdkman.io" | bash
sdkman_dir="$HOME/.sdkman"
{{ else if eq .chezmoi.os "darwin" -}}
brew install sdkman-cli
sdkman_dir="$(brew --prefix)/opt/sdkman-cli/libexec"
{{ end }}

if [[ ! -f "$sdkman_dir/bin/sdkman-init.sh" ]]; then
  echo "❌ SDKMAN installation failed (no init script at $sdkman_dir)."
  exit 1
fi

echo "✅ SDKMAN installed at $sdkman_dir"
